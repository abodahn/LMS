# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# generated
/src/generated

# runtime data (never commit)
/storage
# Any SQLite file, wherever it sits. The development database holds real
# password hashes and the demo employees' records; the root-level one was not
# covered by the prisma/ patterns below.
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/*.db
prisma/*.db-journal
prisma/dev.db*

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo

# env
.env
.env*.local
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

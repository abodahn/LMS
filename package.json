{
  "name": "tc-ai-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:core": "node -e \"process.env.SEED_DEMO='false';require('child_process').execSync('npx tsx prisma/seed/index.ts',{stdio:'inherit',env:process.env})\"",
    "db:reset": "prisma migrate reset --force",
    "admin:create": "tsx scripts/create-admin.mts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run db:seed && next build && playwright test",
    "test:e2e:only": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "catalog:harvest": "tsx scripts/harvest-courses.mts",
    "catalog:filter": "tsx scripts/filter-harvested.mts data/harvested-courses.csv",
    "catalog:import": "tsx scripts/import-courses-csv.mts",
    "catalog:prune": "tsx scripts/prune-harvested.mts data/harvested-courses.csv",
    "catalog:platforms": "tsx scripts/seed-platform-courses.mts",
    "jobs:run": "tsx scripts/run-jobs.mts",
    "jobs:status": "tsx scripts/run-jobs.mts --status",
    "catalog:lessons": "tsx scripts/backfill-lessons.mts",
    "db:backup": "tsx scripts/run-jobs.mts --force --only backup",
    "db:restore-check": "tsx scripts/restore.mts --check",
    "db:restore": "tsx scripts/restore.mts",
    "load-test": "tsx scripts/load-test.mts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}

// ---------------------------------------------------------------------------
// SCORM
// ---------------------------------------------------------------------------

/// An uploaded SCORM package, unpacked on disk and attached to one lesson.
model ScormPackage {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  version      String // 1.2 | 2004
  title        String
  /// Launch file, relative to the package root.
  entryHref    String
  /// Directory under STORAGE_ROOT holding the unpacked files.
  storagePath  String
  fileCount    Int      @default(0)
  sizeBytes    Int      @default(0)
  /// From the manifest; a score at or above this counts as passed.
  masteryScore Float?
  uploadedById String?
  createdAt    DateTime @default(now())

  lesson     CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploadedBy User?        @relation("ScormUploader", fields: [uploadedById], references: [id])
  states     ScormState[]
}

/// One learner's run through one package. The `cmi` blob is what the content
/// wrote; the columns beside it are the few values the rest of the app reads,
/// lifted out so a report never has to parse JSON.
model ScormState {
  id             String    @id @default(cuid())
  packageId      String
  enrollmentId   String
  userId         String
  cmi            String    @default("{}")
  /// 1.2 vocabulary, which 2004 values are mapped onto:
  /// passed | completed | failed | incomplete | browsed | not attempted
  lessonStatus   String    @default("not attempted")
  scoreRaw       Float?
  scoreMin       Float?
  scoreMax       Float?
  location       String?
  suspendData    String?
  sessionSeconds Int       @default(0)
  totalSeconds   Int       @default(0)
  attempts       Int       @default(0)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  package    ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  enrollment Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User         @relation("ScormLearner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, enrollmentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Instructor-led training
// ---------------------------------------------------------------------------

/// A scheduled session: a room and a date, optionally delivering a course.
model TrainingSession {
  id             String   @id @default(cuid())
  courseId       String?
  title          String
  titleAr        String?
  titleTr        String?
  description    String?
  descriptionAr  String?
  descriptionTr  String?
  startsAt       DateTime
  endsAt         DateTime
  timezone       String   @default("Africa/Cairo")
  mode           String   @default("IN_PERSON") // IN_PERSON | ONLINE | HYBRID
  locationId     String?
  room           String?
  meetingUrl     String?
  instructorId   String?
  /// For an external trainer who has no account here.
  instructorName String?
  capacity       Int      @default(20)
  /// Registrations beyond capacity queue instead of being refused.
  waitlistEnabled Boolean @default(true)
  status         String   @default("SCHEDULED") // SCHEDULED | CANCELLED | COMPLETED
  /// Hours credited on attendance; falls back to the session's own length.
  creditHours    Float?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  instructor User?     @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("SessionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  registrations SessionRegistration[]

  @@index([startsAt])
  @@index([courseId])
  @@index([status, startsAt])
}

/// A seat, or a place in the queue for one.
model SessionRegistration {
  id             String    @id @default(cuid())
  sessionId      String
  userId         String
  /// REGISTERED | WAITLISTED | CANCELLED | ATTENDED | ABSENT
  status         String    @default("REGISTERED")
  registeredAt   DateTime  @default(now())
  /// Position in the queue; null once a seat is held.
  waitlistOrder  Int?
  attendanceById String?
  attendanceAt   DateTime?
  notes          String?

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User            @relation("SessionAttendee", fields: [userId], references: [id], onDelete: Cascade)
  markedBy User?           @relation("AttendanceMarker", fields: [attendanceById], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId, status])
}

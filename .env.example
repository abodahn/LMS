# ---------------------------------------------------------------------------
# T&C AI Academy — environment
# Copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# SQLite (single-server / on-premise default):
DATABASE_URL="file:./dev.db"
# PostgreSQL (cloud / multi-user):
#   1. set the URL below
#   2. change `provider` in prisma/schema.prisma to "postgresql"
#   3. run `npm run db:migrate`
# DATABASE_URL="postgresql://tcai:password@localhost:5432/tcai?schema=public"

# Application ----------------------------------------------------------------
APP_URL="http://localhost:3000"
APP_VERSION="1.0.0"
# Uploads (certificates, completion proofs) are stored here, outside the web root.
STORAGE_DIR="./storage"
MAX_UPLOAD_BYTES="8388608"

# Branding (optional — defaults live in src/lib/branding.ts) -------------------
# NEXT_PUBLIC_ORG_NAME="T&C Garments"
# NEXT_PUBLIC_PLATFORM_NAME="T&C AI Academy"
# NEXT_PUBLIC_TAGLINE="Learn AI. Apply AI. Improve Work."
# NEXT_PUBLIC_LOGO_URL="/brand/logo.svg"
# NEXT_PUBLIC_LOGO_MARK_URL="/brand/logo-mark.svg"
# NEXT_PUBLIC_FAVICON_URL="/brand/favicon.svg"
# NEXT_PUBLIC_BRAND_RED="#C8102E"
# NEXT_PUBLIC_BRAND_INK="#16181D"
# NEXT_PUBLIC_SUPPORT_EMAIL="learning@tcgarments.com"

# AI provider (optional) ------------------------------------------------------
# Enable in Admin -> Integrations, then supply the matching key here.
# Keys are read on the server only and are never sent to the browser.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# AI_API_KEY=""          # any other OpenAI-compatible endpoint

# SMTP (optional) -------------------------------------------------------------
# Host, port, user and sender are configured in Admin -> Integrations.
# SMTP_PASSWORD=""

# Seeding ---------------------------------------------------------------------
# SEED_DEMO="false"      # production installs: skip the 36 demo employees
# DEMO_PASSWORD="Academy2026!"

# Single sign-on (optional) -----------------------------------------------------
# OpenID Connect, e.g. Microsoft Entra ID. Register the redirect URI
# <APP_URL>/api/auth/oidc/callback with the provider. People must already exist
# here (HR sync or import); they are matched on email.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Microsoft

# HR sync over SCIM 2.0 (optional) ----------------------------------------------
# Endpoint: <APP_URL>/api/scim/v2 — give the identity provider this bearer token.
# SCIM_TOKEN=

# SCORM on its own hostname (recommended before accepting outside packages) ----
# A second DNS name pointing at this same service, plus a random signing secret.
# SCORM_CONTENT_ORIGIN=https://scorm.example.com
# SCORM_TOKEN_SECRET=
